\end_layout

\end_inset


\begin_inset Formula 
\[
[\text{small open economy}]\ \ \ \ \ \ \ 1+t_{ji,k}^{\star}=\frac{1+(\sigma_{k}-1)\lambda_{ii,k}}{1+\frac{1+\overline{\mu}_{i}}{1+\mu_{k}}(\sigma_{k}-1)\lambda_{ii,k}};\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ 1+x_{ij,k}^{\star}=\left(\frac{\sigma_{k}-1}{\sigma_{k}}\right)\frac{1+\mu_{k}}{1+\overline{\mu}_{i}}.
\]

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset

 For a 
